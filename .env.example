# Copy to .env and fill in
DB_PASSWORD=change-me-strong-password
# long random string, e.g. output of: openssl rand -hex 32
TOKEN_SECRET=change-me-random-64-chars
# usernames (comma separated) that may add/withdraw challenges
ADMIN_USERNAMES=
# your domain for automatic HTTPS (DNS A-record must point to the server), or ":80" for plain http
SITE_ADDRESS=:80

# public address of the site (used in password-reset links), e.g. https://pixelcode.example.com
FRONTEND_URL=http://localhost
# SMTP for e-mails (leave MAIL_HOST empty -> links are only printed to `docker compose logs backend`)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
