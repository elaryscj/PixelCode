# Copy to .env and fill in
DB_PASSWORD=change-me-strong-password
# long random string, e.g. output of: openssl rand -hex 32
TOKEN_SECRET=change-me-random-64-chars
# usernames (comma separated) that may add/withdraw challenges
ADMIN_USERNAMES=
# your domain for automatic HTTPS (DNS A-record must point to the server), or ":80" for plain http
SITE_ADDRESS=:80

# public address of the site (used in password-reset links), e.g. https://pixelcode.example.com
FRONTEND_URL=http://localhost
# SMTP for e-mails (leave MAIL_HOST empty -> links are only printed to `docker compose logs backend`)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ---- optional ----
# e-mail through Brevo's HTTPS API (Render's free plan blocks SMTP); MAIL_FROM must be a sender verified in Brevo
BREVO_API_KEY=
# where the server runs, shown in the game header (e.g. frankfurt)
SERVER_REGION=
# ban length in minutes for abandoning a match
BAN_MINUTES=30
# public backend address (payment callbacks), e.g. https://api.example.com
BACKEND_URL=
# teacher subscription
TEACHER_PRICE_MONTH=4990
TEACHER_PRICE_YEAR=39990
TEACHER_CURRENCY=KZT
TEACHER_TRIAL_DAYS=14
# online payment (Freedom Pay); stays off until both are set. FREEDOM_TESTING=true = test cards
FREEDOM_MERCHANT_ID=
FREEDOM_SECRET_KEY=
FREEDOM_TESTING=true
